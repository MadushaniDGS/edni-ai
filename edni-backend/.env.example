# ─── Edni AI Backend — Environment Variables ──────────────────────────────────
# Copy this to .env and fill in all values before running

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Edni AI Backend
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development   # development | production

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local:    postgresql+asyncpg://user:password@localhost:5432/edni_db
# Docker:   postgresql+asyncpg://edni:edni_pass@postgres:5432/edni_db
# Supabase: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://edni:edni_pass@localhost:5432/edni_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:  redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=edni_logs

# ── LLM — Groq (Llama-3-70B) ─────────────────────────────────────────────────
# Get free API key: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ── Pinecone (Vector Database) ────────────────────────────────────────────────
# Get API key: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=edni-oer
PINECONE_DIMENSION=768

# ── Cohere (Reranking) ────────────────────────────────────────────────────────
# Get API key: https://dashboard.cohere.com
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=rerank-english-v3.0

# ── IRT Parameters ────────────────────────────────────────────────────────────
THETA_MIN=-4.0
THETA_MAX=4.0
IRT_MAX_ITERATIONS=50

# ── Agent Settings ────────────────────────────────────────────────────────────
MAX_FEEDBACK_CYCLES=3
PLATEAU_THRESHOLD=0.05      # 5% mastery gain threshold
PLATEAU_WEEKS=2
REFLEXION_ROUNDS=2

# ── Study Plan ────────────────────────────────────────────────────────────────
SEMESTER_WEEKS=16
MAX_HOURS_PER_WEEK=20

# ── RAG ───────────────────────────────────────────────────────────────────────
TOP_K_RETRIEVE=20
TOP_N_RERANK=5

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
